{% comment %}
  Comparison Table Section - Compare with alternatives
  Show why your product is superior to competitors or alternatives
{% endcomment %}

<div class="comparison-table">
  {% if section.settings.heading != blank %}
    <h2 class="comparison-table__heading">{{ section.settings.heading }}</h2>
  {% endif %}
  
  {% if section.settings.subheading != blank %}
    <p class="comparison-table__subheading">{{ section.settings.subheading }}</p>
  {% endif %}

  <div class="comparison-table__wrapper">
    <table class="comparison-table__table">
      <thead>
        <tr>
          <th class="comparison-table__feature-header">{{ section.settings.feature_column_label }}</th>
          <th class="comparison-table__product-header comparison-table__product-header--highlight">
            {{ section.settings.your_product_label }}
          </th>
          {% for block in section.blocks %}
            {% if block.type == 'competitor' %}
              <th class="comparison-table__product-header">{{ block.settings.name }}</th>
            {% endif %}
          {% endfor %}
        </tr>
      </thead>
      <tbody>
        {% for block in section.blocks %}
          {% if block.type == 'feature' %}
            <tr {{ block.shopify_attributes }}>
              <td class="comparison-table__feature">{{ block.settings.feature_name }}</td>
              <td class="comparison-table__cell comparison-table__cell--highlight">
                {% if block.settings.your_product == 'yes' %}
                  <span class="comparison-table__check">✓</span>
                {% elsif block.settings.your_product == 'no' %}
                  <span class="comparison-table__cross">✗</span>
                {% else %}
                  <span class="comparison-table__text">{{ block.settings.your_product }}</span>
                {% endif %}
              </td>
              <td class="comparison-table__cell">
                {% if block.settings.competitor_1 == 'yes' %}
                  <span class="comparison-table__check">✓</span>
                {% elsif block.settings.competitor_1 == 'no' %}
                  <span class="comparison-table__cross">✗</span>
                {% else %}
                  <span class="comparison-table__text">{{ block.settings.competitor_1 }}</span>
                {% endif %}
              </td>
              {% if section.blocks | where: 'type', 'competitor' | size > 1 %}
                <td class="comparison-table__cell">
                  {% if block.settings.competitor_2 == 'yes' %}
                    <span class="comparison-table__check">✓</span>
                  {% elsif block.settings.competitor_2 == 'no' %}
                    <span class="comparison-table__cross">✗</span>
                  {% else %}
                    <span class="comparison-table__text">{{ block.settings.competitor_2 }}</span>
                  {% endif %}
                </td>
              {% endif %}
            </tr>
          {% endif %}
        {% endfor %}
      </tbody>
    </table>
  </div>

  {% if section.settings.cta_text != blank %}
    <div class="comparison-table__cta">
      <a href="{{ section.settings.cta_link | default: '#' }}" class="btn btn--primary btn--large">
        {{ section.settings.cta_text }}
      </a>
    </div>
  {% endif %}
</div>

{% stylesheet %}
  .comparison-table {
    padding: 4rem 0;
    text-align: center;
  }

  .comparison-table__heading {
    font-size: clamp(2rem, 4vw, 2.5rem);
    font-weight: bold;
    margin-bottom: 1rem;
  }

  .comparison-table__subheading {
    font-size: 1.125rem;
    color: #666;
    max-width: 600px;
    margin: 0 auto 3rem;
    line-height: 1.6;
  }

  .comparison-table__wrapper {
    overflow-x: auto;
    margin: 2rem 0;
  }

  .comparison-table__table {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0;
    background: white;
    box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    border-radius: 8px;
    overflow: hidden;
  }

  .comparison-table__table th,
  .comparison-table__table td {
    padding: 1.25rem;
    text-align: center;
    border-bottom: 1px solid #e0e0e0;
  }

  .comparison-table__table thead th {
    background-color: #f5f5f5;
    font-weight: 600;
    font-size: 1rem;
    border-bottom: 2px solid #ddd;
  }

  .comparison-table__feature-header {
    text-align: left !important;
    min-width: 200px;
  }

  .comparison-table__product-header--highlight {
    background-color: #000;
    color: white;
  }

  .comparison-table__feature {
    text-align: left !important;
    font-weight: 500;
  }

  .comparison-table__cell--highlight {
    background-color: #f9f9f9;
  }

  .comparison-table__check {
    color: #4caf50;
    font-size: 1.5rem;
    font-weight: bold;
  }

  .comparison-table__cross {
    color: #f44336;
    font-size: 1.5rem;
    font-weight: bold;
  }

  .comparison-table__text {
    font-size: 0.9rem;
    color: #666;
  }

  .comparison-table__table tbody tr:last-child td {
    border-bottom: none;
  }

  .comparison-table__cta {
    margin-top: 2rem;
  }

  .btn--large {
    padding: 1.25rem 3rem;
    font-size: 1.25rem;
  }

  @media (max-width: 767px) {
    .comparison-table__table th,
    .comparison-table__table td {
      padding: 1rem 0.75rem;
      font-size: 0.9rem;
    }

    .comparison-table__feature-header {
      min-width: 150px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Comparison Table",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "How We Compare"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Section Subheading",
      "default": "See why customers choose us over the competition"
    },
    {
      "type": "text",
      "id": "feature_column_label",
      "label": "Feature Column Label",
      "default": "Feature"
    },
    {
      "type": "text",
      "id": "your_product_label",
      "label": "Your Product Name",
      "default": "Our Product"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Call to Action Text",
      "info": "Leave blank to hide button"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Call to Action Link"
    }
  ],
  "blocks": [
    {
      "type": "competitor",
      "name": "Competitor",
      "limit": 2,
      "settings": [
        {
          "type": "text",
          "id": "name",
          "label": "Competitor Name",
          "default": "Competitor"
        }
      ]
    },
    {
      "type": "feature",
      "name": "Feature Row",
      "settings": [
        {
          "type": "text",
          "id": "feature_name",
          "label": "Feature Name",
          "default": "Premium Materials"
        },
        {
          "type": "select",
          "id": "your_product",
          "label": "Your Product",
          "options": [
            {
              "value": "yes",
              "label": "Yes (✓)"
            },
            {
              "value": "no",
              "label": "No (✗)"
            },
            {
              "value": "custom",
              "label": "Custom Text"
            }
          ],
          "default": "yes"
        },
        {
          "type": "select",
          "id": "competitor_1",
          "label": "Competitor 1",
          "options": [
            {
              "value": "yes",
              "label": "Yes (✓)"
            },
            {
              "value": "no",
              "label": "No (✗)"
            },
            {
              "value": "custom",
              "label": "Custom Text"
            }
          ],
          "default": "no"
        },
        {
          "type": "select",
          "id": "competitor_2",
          "label": "Competitor 2",
          "options": [
            {
              "value": "yes",
              "label": "Yes (✓)"
            },
            {
              "value": "no",
              "label": "No (✗)"
            },
            {
              "value": "custom",
              "label": "Custom Text"
            }
          ],
          "default": "no"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Comparison Table",
      "blocks": [
        {
          "type": "competitor",
          "settings": {
            "name": "Standard Brand"
          }
        },
        {
          "type": "competitor",
          "settings": {
            "name": "Budget Option"
          }
        },
        {
          "type": "feature",
          "settings": {
            "feature_name": "Premium Materials",
            "your_product": "yes",
            "competitor_1": "no",
            "competitor_2": "no"
          }
        },
        {
          "type": "feature",
          "settings": {
            "feature_name": "30-Day Guarantee",
            "your_product": "yes",
            "competitor_1": "no",
            "competitor_2": "no"
          }
        },
        {
          "type": "feature",
          "settings": {
            "feature_name": "Free Shipping",
            "your_product": "yes",
            "competitor_1": "yes",
            "competitor_2": "no"
          }
        }
      ]
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
