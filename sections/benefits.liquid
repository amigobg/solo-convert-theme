{% comment %}
  Benefits Section - Key product benefits with icons
  Designed to highlight 3-6 core benefits with visual icons
{% endcomment %}

<div class="benefits">
  {% if section.settings.heading != blank %}
    <h2 class="benefits__heading">{{ section.settings.heading }}</h2>
  {% endif %}
  
  {% if section.settings.subheading != blank %}
    <p class="benefits__subheading">{{ section.settings.subheading }}</p>
  {% endif %}

  <div class="benefits__grid">
    {% for block in section.blocks %}
      <div class="benefit" {{ block.shopify_attributes }}>
        {% if block.settings.icon != blank %}
          <div class="benefit__icon">
            <img src="{{ block.settings.icon | image_url: width: 80 }}" alt="{{ block.settings.title }}" loading="lazy">
          </div>
        {% elsif block.settings.emoji != blank %}
          <div class="benefit__emoji">{{ block.settings.emoji }}</div>
        {% endif %}
        
        {% if block.settings.title != blank %}
          <h3 class="benefit__title">{{ block.settings.title }}</h3>
        {% endif %}
        
        {% if block.settings.description != blank %}
          <p class="benefit__description">{{ block.settings.description }}</p>
        {% endif %}
      </div>
    {% endfor %}
  </div>
</div>

{% stylesheet %}
  .benefits {
    padding: 4rem 0;
    text-align: center;
  }

  .benefits__heading {
    font-size: clamp(2rem, 4vw, 2.5rem);
    font-weight: bold;
    margin-bottom: 1rem;
  }

  .benefits__subheading {
    font-size: 1.125rem;
    color: #666;
    max-width: 600px;
    margin: 0 auto 3rem;
    line-height: 1.6;
  }

  .benefits__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 2rem;
    margin-top: 2rem;
  }

  @media (min-width: 768px) {
    .benefits__grid {
      gap: 3rem;
    }
  }

  .benefit {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    padding: 1.5rem;
  }

  .benefit__icon {
    width: 80px;
    height: 80px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .benefit__icon img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .benefit__emoji {
    font-size: 3rem;
    line-height: 1;
  }

  .benefit__title {
    font-size: 1.25rem;
    font-weight: 600;
    margin: 0;
  }

  .benefit__description {
    font-size: 0.95rem;
    color: #666;
    line-height: 1.6;
    max-width: 300px;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Product Benefits",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "Why Choose This Product?"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Section Subheading",
      "default": "Here's what makes our product stand out from the rest"
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon Image",
          "info": "Upload an icon or leave blank to use emoji"
        },
        {
          "type": "text",
          "id": "emoji",
          "label": "Emoji (if no icon)",
          "default": "✓",
          "info": "Used if no icon image is uploaded"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Benefit Title",
          "default": "Premium Quality"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Benefit Description",
          "default": "Made with the finest materials for lasting durability"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product Benefits",
      "blocks": [
        {
          "type": "benefit",
          "settings": {
            "emoji": "🏆",
            "title": "Premium Quality",
            "description": "Made with the finest materials for lasting durability"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "emoji": "🚀",
            "title": "Fast Shipping",
            "description": "Get your order delivered in 2-3 business days"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "emoji": "💯",
            "title": "Satisfaction Guaranteed",
            "description": "30-day money-back guarantee on all orders"
          }
        }
      ]
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
