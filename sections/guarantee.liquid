{% comment %}
  Guarantee Section - Risk Reversal
  Build trust with money-back guarantee and risk-free messaging
{% endcomment %}

<div class="guarantee" style="--bg-color: {{ section.settings.background_color }}">
  <div class="guarantee__container">
    {% if section.settings.badge_image != blank %}
      <div class="guarantee__badge">
        <img 
          src="{{ section.settings.badge_image | image_url: width: 200 }}" 
          alt="{{ section.settings.heading }}"
          loading="lazy"
        >
      </div>
    {% elsif section.settings.badge_emoji != blank %}
      <div class="guarantee__emoji">{{ section.settings.badge_emoji }}</div>
    {% endif %}

    <div class="guarantee__content">
      {% if section.settings.heading != blank %}
        <h2 class="guarantee__heading">{{ section.settings.heading }}</h2>
      {% endif %}

      {% if section.settings.subheading != blank %}
        <p class="guarantee__subheading">{{ section.settings.subheading }}</p>
      {% endif %}

      {% if section.settings.description != blank %}
        <div class="guarantee__description">{{ section.settings.description }}</div>
      {% endif %}

      {% if section.blocks.size > 0 %}
        <div class="guarantee__features">
          {% for block in section.blocks %}
            <div class="guarantee-feature" {{ block.shopify_attributes }}>
              {% if block.settings.icon != blank %}
                <span class="guarantee-feature__icon">{{ block.settings.icon }}</span>
              {% endif %}
              <span class="guarantee-feature__text">{{ block.settings.text }}</span>
            </div>
          {% endfor %}
        </div>
      {% endif %}

      {% if section.settings.cta_text != blank %}
        <a href="{{ section.settings.cta_link | default: '#' }}" class="guarantee__button btn btn--primary">
          {{ section.settings.cta_text }}
        </a>
      {% endif %}
    </div>
  </div>
</div>

{% stylesheet %}
  .guarantee {
    padding: 4rem 0;
    background-color: var(--bg-color, #f0f8ff);
  }

  .guarantee__container {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 2rem;
  }

  @media (min-width: 768px) {
    .guarantee__container {
      flex-direction: row;
      text-align: left;
      gap: 3rem;
    }
  }

  .guarantee__badge {
    flex-shrink: 0;
  }

  .guarantee__badge img {
    width: 150px;
    height: auto;
  }

  .guarantee__emoji {
    font-size: 5rem;
    line-height: 1;
    flex-shrink: 0;
  }

  .guarantee__content {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: 700px;
  }

  .guarantee__heading {
    font-size: clamp(1.75rem, 4vw, 2.25rem);
    font-weight: bold;
    line-height: 1.2;
    margin: 0;
  }

  .guarantee__subheading {
    font-size: 1.25rem;
    color: #555;
    line-height: 1.5;
    margin: 0;
  }

  .guarantee__description {
    font-size: 1rem;
    color: #666;
    line-height: 1.7;
  }

  .guarantee__description p {
    margin-bottom: 0.75rem;
  }

  .guarantee__description p:last-child {
    margin-bottom: 0;
  }

  .guarantee__features {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }

  .guarantee-feature {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  @media (max-width: 767px) {
    .guarantee-feature {
      justify-content: center;
    }
  }

  .guarantee-feature__icon {
    font-size: 1.25rem;
    flex-shrink: 0;
  }

  .guarantee-feature__text {
    font-size: 1rem;
    color: #555;
  }

  .guarantee__button {
    margin-top: 1rem;
    align-self: center;
    text-decoration: none;
  }

  @media (min-width: 768px) {
    .guarantee__button {
      align-self: flex-start;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Guarantee",
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#f0f8ff"
    },
    {
      "type": "image_picker",
      "id": "badge_image",
      "label": "Guarantee Badge Image",
      "info": "Upload a badge/seal image or leave blank to use emoji"
    },
    {
      "type": "text",
      "id": "badge_emoji",
      "label": "Badge Emoji (if no image)",
      "default": "🛡️",
      "info": "Used if no badge image is uploaded"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Guarantee Headline",
      "default": "100% Money-Back Guarantee"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Guarantee Promise",
      "default": "Try it risk-free for 30 days"
    },
    {
      "type": "html",
      "id": "description",
      "label": "Guarantee Details",
      "default": "<p>We're so confident you'll love our product that we offer a no-questions-asked 30-day money-back guarantee. If you're not completely satisfied, we'll refund your purchase.</p>"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Call to Action Text",
      "info": "Leave blank to hide button"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Call to Action Link"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Guarantee Feature",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Icon/Emoji",
          "default": "✓"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Feature Text",
          "default": "No risk, no hassle"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Guarantee",
      "blocks": [
        {
          "type": "feature",
          "settings": {
            "icon": "✓",
            "text": "No questions asked refund"
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon": "✓",
            "text": "Full 30 days to try"
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon": "✓",
            "text": "Fast refund processing"
          }
        }
      ]
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
