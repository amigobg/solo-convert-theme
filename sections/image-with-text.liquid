{% comment %}
  Image with Text Section - Problem → Solution Narrative
  Flexible section for storytelling with image and text combinations
{% endcomment %}

<div class="image-with-text {{ section.settings.layout }}" style="--bg-color: {{ section.settings.background_color }}">
  <div class="image-with-text__media">
    {% if section.settings.image != blank %}
      {% render 'image', 
        image: section.settings.image, 
        class: 'image-with-text__image',
        width: 1200 
      %}
    {% else %}
      <div class="image-with-text__placeholder">
        {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
      </div>
    {% endif %}
  </div>

  <div class="image-with-text__content">
    {% if section.settings.eyebrow != blank %}
      <div class="image-with-text__eyebrow">{{ section.settings.eyebrow }}</div>
    {% endif %}

    {% if section.settings.heading != blank %}
      <h2 class="image-with-text__heading">{{ section.settings.heading }}</h2>
    {% endif %}

    {% if section.settings.text != blank %}
      <div class="image-with-text__text">{{ section.settings.text }}</div>
    {% endif %}

    {% if section.settings.button_text != blank %}
      <a href="{{ section.settings.button_link | default: '#' }}" class="image-with-text__button btn btn--primary">
        {{ section.settings.button_text }}
      </a>
    {% endif %}

    {% if section.blocks.size > 0 %}
      <div class="image-with-text__points">
        {% for block in section.blocks %}
          <div class="point" {{ block.shopify_attributes }}>
            {% if block.settings.icon != blank %}
              <span class="point__icon">{{ block.settings.icon }}</span>
            {% endif %}
            <span class="point__text">{{ block.settings.text }}</span>
          </div>
        {% endfor %}
      </div>
    {% endif %}
  </div>
</div>

{% stylesheet %}
  .image-with-text {
    display: grid;
    gap: 2rem;
    padding: 4rem 0;
    background-color: var(--bg-color, transparent);
    align-items: center;
  }

  @media (min-width: 768px) {
    .image-with-text {
      grid-template-columns: 1fr 1fr;
      gap: 4rem;
    }

    .image-with-text.image-right {
      direction: rtl;
    }

    .image-with-text.image-right > * {
      direction: ltr;
    }
  }

  .image-with-text__media {
    position: relative;
    width: 100%;
  }

  .image-with-text__image img {
    width: 100%;
    height: auto;
    border-radius: 8px;
  }

  .image-with-text__placeholder {
    aspect-ratio: 4/3;
    background-color: #f5f5f5;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .image-with-text__content {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .image-with-text__eyebrow {
    font-size: 0.875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #666;
  }

  .image-with-text__heading {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: bold;
    line-height: 1.2;
    margin: 0;
  }

  .image-with-text__text {
    font-size: 1.0625rem;
    line-height: 1.7;
    color: #555;
  }

  .image-with-text__text p {
    margin-bottom: 1rem;
  }

  .image-with-text__text p:last-child {
    margin-bottom: 0;
  }

  .image-with-text__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    align-self: flex-start;
    text-decoration: none;
    margin-top: 0.5rem;
  }

  .image-with-text__points {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-top: 0.5rem;
  }

  .point {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
  }

  .point__icon {
    font-size: 1.25rem;
    flex-shrink: 0;
  }

  .point__text {
    font-size: 1rem;
    line-height: 1.6;
    color: #555;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Image with Text",
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "label": "Image Position",
      "options": [
        {
          "value": "image-left",
          "label": "Image Left"
        },
        {
          "value": "image-right",
          "label": "Image Right"
        }
      ],
      "default": "image-left"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Section Image"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "info": "Small text above heading"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Solve Your Problem"
    },
    {
      "type": "html",
      "id": "text",
      "label": "Description",
      "default": "<p>Tell your story here. Explain the problem your customers face and how your product solves it.</p>"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "info": "Leave blank to hide button"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "Key Point",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Icon/Emoji",
          "default": "✓"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Point Text",
          "default": "Key benefit or feature"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Image with Text",
      "blocks": [
        {
          "type": "point",
          "settings": {
            "icon": "✓",
            "text": "Solves your main pain point"
          }
        },
        {
          "type": "point",
          "settings": {
            "icon": "✓",
            "text": "Easy to use and implement"
          }
        },
        {
          "type": "point",
          "settings": {
            "icon": "✓",
            "text": "Backed by science and research"
          }
        }
      ]
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
