{% comment %}
  FAQ Section - Accordion Style
  Answer common questions to overcome objections
{% endcomment %}

<div class="faq">
  {% if section.settings.heading != blank %}
    <h2 class="faq__heading">{{ section.settings.heading }}</h2>
  {% endif %}
  
  {% if section.settings.subheading != blank %}
    <p class="faq__subheading">{{ section.settings.subheading }}</p>
  {% endif %}

  <div class="faq__items">
    {% for block in section.blocks %}
      <details class="faq-item" {{ block.shopify_attributes }}>
        <summary class="faq-item__question">
          <span>{{ block.settings.question }}</span>
          <span class="faq-item__icon">+</span>
        </summary>
        <div class="faq-item__answer">
          {{ block.settings.answer }}
        </div>
      </details>
    {% endfor %}
  </div>

  {% if section.settings.contact_text != blank %}
    <div class="faq__contact">
      <p>{{ section.settings.contact_text }}</p>
      {% if section.settings.contact_link_text != blank %}
        <a href="{{ section.settings.contact_link | default: '#' }}" class="faq__contact-link">
          {{ section.settings.contact_link_text }}
        </a>
      {% endif %}
    </div>
  {% endif %}
</div>

{% stylesheet %}
  .faq {
    padding: 4rem 0;
    max-width: 800px;
    margin: 0 auto;
  }

  .faq__heading {
    font-size: clamp(2rem, 4vw, 2.5rem);
    font-weight: bold;
    text-align: center;
    margin-bottom: 1rem;
  }

  .faq__subheading {
    font-size: 1.125rem;
    color: #666;
    text-align: center;
    margin: 0 auto 3rem;
    line-height: 1.6;
  }

  .faq__items {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .faq-item {
    background: white;
    border: 1px solid #e0e0e0;
    border-radius: 8px;
    overflow: hidden;
  }

  .faq-item__question {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.25rem 1.5rem;
    font-size: 1.0625rem;
    font-weight: 600;
    cursor: pointer;
    user-select: none;
    list-style: none;
    transition: background-color 0.2s ease;
  }

  .faq-item__question::-webkit-details-marker {
    display: none;
  }

  .faq-item__question:hover {
    background-color: #f9f9f9;
  }

  .faq-item__icon {
    font-size: 1.5rem;
    font-weight: 300;
    flex-shrink: 0;
    margin-left: 1rem;
    transition: transform 0.3s ease;
  }

  .faq-item[open] .faq-item__icon {
    transform: rotate(45deg);
  }

  .faq-item__answer {
    padding: 0 1.5rem 1.5rem 1.5rem;
    font-size: 1rem;
    line-height: 1.7;
    color: #555;
  }

  .faq-item__answer p {
    margin-bottom: 0.75rem;
  }

  .faq-item__answer p:last-child {
    margin-bottom: 0;
  }

  .faq__contact {
    margin-top: 3rem;
    padding: 2rem;
    background-color: #f9f9f9;
    border-radius: 8px;
    text-align: center;
  }

  .faq__contact p {
    font-size: 1rem;
    color: #555;
    margin-bottom: 1rem;
  }

  .faq__contact-link {
    display: inline-block;
    color: #000;
    font-weight: 600;
    text-decoration: underline;
    transition: opacity 0.2s ease;
  }

  .faq__contact-link:hover {
    opacity: 0.7;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "FAQ",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "Frequently Asked Questions"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Section Subheading",
      "default": "Got questions? We've got answers."
    },
    {
      "type": "header",
      "content": "Contact Section"
    },
    {
      "type": "text",
      "id": "contact_text",
      "label": "Contact Text",
      "default": "Still have questions?",
      "info": "Leave blank to hide contact section"
    },
    {
      "type": "text",
      "id": "contact_link_text",
      "label": "Contact Link Text",
      "default": "Contact Us"
    },
    {
      "type": "url",
      "id": "contact_link",
      "label": "Contact Link"
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "What is your shipping policy?"
        },
        {
          "type": "html",
          "id": "answer",
          "label": "Answer",
          "default": "<p>We offer free shipping on all orders over $50. Standard shipping takes 3-5 business days.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ",
      "blocks": [
        {
          "type": "question",
          "settings": {
            "question": "What is your shipping policy?",
            "answer": "<p>We offer free shipping on all orders over $50. Standard shipping takes 3-5 business days.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "What is your return policy?",
            "answer": "<p>We offer a 30-day money-back guarantee. If you're not satisfied, return it for a full refund.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "How do I know if this product is right for me?",
            "answer": "<p>Our product is designed for anyone looking to [solve specific problem]. If you're experiencing [pain point], this is perfect for you.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "Is this product safe to use?",
            "answer": "<p>Yes! Our product is made with high-quality, safe materials and has been tested for quality and safety.</p>"
          }
        }
      ]
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
